# Copy to .env and adjust. Never commit .env -- it can hold a database password
# and private calendar links.

# --- required ---------------------------------------------------------------

# The URL the board uses to reach this server (no trailing slash). Behind a
# reverse proxy: https://eink.example.com. On a LAN without one:
# http://<host-ip>:8099 together with INKWAKE_BIND=0.0.0.0.
PUBLIC_BASE_URL=https://eink.example.com

# --- network ----------------------------------------------------------------

# Where the container port is published. Loopback by default, for a reverse
# proxy on the same host.
INKWAKE_BIND=127.0.0.1
INKWAKE_PORT=8099

# Protects /preview and /api/internal/status. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty means those two endpoints are open -- fine on a laptop, not on a host.
ADMIN_API_KEY=

# --- display ----------------------------------------------------------------

TZ_NAME=Europe/Vienna
WEATHER_LAT=48.2082
WEATHER_LON=16.3738

# --- events panel: any number of iCalendar feeds, comma-separated -----------

# A private calendar link is a password; it only ever goes into this file.
EVENTS_ICS_URLS=
EVENTS_COUNT=6
EVENTS_DAYS_AHEAD=7
EVENTS_TITLE=Termine

# --- optional: bookings and sightings from Postgres views --------------------

# A read-only role is enough; see docs/data-sources.md for the two views.
# Empty disables both panels.
SOURCES_DSN=
BOOKINGS_VIEW=inkwake_bookings
BOOKINGS_COUNT=3
BOOKINGS_TITLE=Buchungen
SIGHTINGS_VIEW=inkwake_sightings
SIGHTING_TITLE=Sichtung
# Host directory with the pictures the sightings view's image_path points into.
SIGHTINGS_HOST_DIR=./sightings

# --- tuning (the defaults are fine) -----------------------------------------

SOURCE_CACHE_TTL_S=3600
HTTP_TIMEOUT_S=15.0
DEVICE_HTTP_TIMEOUT_S=8.0
PREWARM_LEAD_S=300
WARM_ON_START=true
LOG_LEVEL=INFO
# Empty: "inkwake/1.0 (+https://github.com/Juice-de-Orange/inkwake)".
USER_AGENT=
